# Copie este arquivo para ".env" (mesma pasta do pom.xml) e preencha com os SEUS valores.
# O arquivo .env está no .gitignore e nunca deve ser commitado.

DB_URL=jdbc:oracle:thin:@HOST:1521:SID
DB_USER=seu_usuario_oracle
DB_PASSWORD=sua_senha_oracle

# Gere uma chave aleatória com pelo menos 32 caracteres (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# Conta da CLINICA (admin) criada automaticamente na primeira inicialização
ADMIN_NOME=Administrador PetCare
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=defina-uma-senha-forte

# Opcionais
# SHOW_SQL=false
# THYMELEAF_CACHE=true
# JWT_EXPIRATION_MS=3600000
# JWT_REFRESH_EXPIRATION_MS=604800000
