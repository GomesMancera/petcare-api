# Copie este arquivo para application-secrets.yml (local) ou exporte as variáveis:
# ORACLE_USER, ORACLE_PASSWORD, JWT_SECRET
#
# Exemplo PowerShell:
#   $env:ORACLE_USER="rmXXXXXX"
#   $env:ORACLE_PASSWORD="sua_senha"
#   $env:JWT_SECRET="chave-longa-aleatoria"
#   mvn spring-boot:run
#
# Para testar sem Oracle:
#   mvn spring-boot:run "-Dspring-boot.run.profiles=local"
